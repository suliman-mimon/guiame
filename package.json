{
  "name": "repo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c \"blue,green\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "predev": "convex dev --until-success",
    "dev:backend": "convex dev",
    "dev:frontend": "next dev",
    "build": "next build",
    "logs": "convex logs",
    "typecheck": "tsc -p convex && tsc -p . --noEmit",
    "lint": "npm run typecheck && eslint . --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "convex": "^1.44.0",
    "lucide-react": "^1.67.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
